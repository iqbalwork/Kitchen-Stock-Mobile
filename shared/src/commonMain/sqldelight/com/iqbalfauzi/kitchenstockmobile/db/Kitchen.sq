CREATE TABLE Category (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    icon TEXT
);

CREATE TABLE StorageLocation (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT
);

CREATE TABLE Product (
    id TEXT NOT NULL PRIMARY KEY,
    categoryId TEXT,
    name TEXT NOT NULL,
    barcode TEXT,
    unit TEXT NOT NULL,
    minStockLevel REAL,
    imageUrl TEXT,
    FOREIGN KEY(categoryId) REFERENCES Category(id)
);

CREATE TABLE Inventory (
    id TEXT NOT NULL PRIMARY KEY,
    productId TEXT NOT NULL,
    storageLocationId TEXT NOT NULL,
    quantity REAL NOT NULL,
    expiryDate TEXT,
    updatedAt TEXT NOT NULL,
    FOREIGN KEY(productId) REFERENCES Product(id),
    FOREIGN KEY(storageLocationId) REFERENCES StorageLocation(id)
);

-- Queries
getInventoryWithDetails:
SELECT
    Inventory.*,
    Product.name AS productName,
    Product.unit AS productUnit,
    Product.imageUrl AS productImageUrl,
    Product.categoryId AS productCategoryId,
    StorageLocation.name AS locationName,
    Category.name AS categoryName,
    Category.icon AS categoryIcon
FROM Inventory
JOIN Product ON Inventory.productId = Product.id
JOIN StorageLocation ON Inventory.storageLocationId = StorageLocation.id
LEFT JOIN Category ON Product.categoryId = Category.id;

getInventoryItemById:
SELECT
    Inventory.*,
    Product.name AS productName,
    Product.unit AS productUnit,
    Product.imageUrl AS productImageUrl,
    Product.categoryId AS productCategoryId,
    StorageLocation.name AS locationName,
    Category.name AS categoryName,
    Category.icon AS categoryIcon
FROM Inventory
JOIN Product ON Inventory.productId = Product.id
JOIN StorageLocation ON Inventory.storageLocationId = StorageLocation.id
LEFT JOIN Category ON Product.categoryId = Category.id
WHERE Inventory.id = ?;

insertInventory:
INSERT OR REPLACE INTO Inventory(id, productId, storageLocationId, quantity, expiryDate, updatedAt)
VALUES (?, ?, ?, ?, ?, ?);

insertProduct:
INSERT OR REPLACE INTO Product(id, categoryId, name, barcode, unit, minStockLevel, imageUrl)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertCategory:
INSERT OR REPLACE INTO Category(id, name, icon)
VALUES (?, ?, ?);

insertStorageLocation:
INSERT OR REPLACE INTO StorageLocation(id, name, description)
VALUES (?, ?, ?);

deleteAllInventory:
DELETE FROM Inventory;

deleteInventoryById:
DELETE FROM Inventory WHERE id = ?;

deleteAllProducts:
DELETE FROM Product;

deleteAllCategories:
DELETE FROM Category;

deleteAllStorageLocations:
DELETE FROM StorageLocation;

getAllProducts:
SELECT * FROM Product;

getAllStorageLocations:
SELECT * FROM StorageLocation;

getAllCategories:
SELECT * FROM Category;
